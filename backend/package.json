{
  "name": "everest-textile-backend",
  "version": "0.1.0",
  "description": "Everest Textile Mills ERP backend",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/db/seed.ts",
    "seed:realistic": "bun src/scripts/seedRealistic.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-request-id": "^3.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "onnxruntime-node": "^1.30.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
